{
  "entities": {
    "Teacher": {
      "title": "Teacher",
      "description": "Teacher profile and role information",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "role": { "type": "string", "enum": ["teacher", "admin"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    },
    "Student": {
      "title": "Student",
      "description": "Student record with assigned unique ID and class",
      "type": "object",
      "properties": {
        "studentId": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "classId": { "type": "number" },
        "createdAt": { "type": "string" },
        "lastActiveAt": { "type": "string" }
      },
      "required": ["studentId", "name", "classId"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Curriculum subject applicable to classes 1-10",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "name": { "type": "string", "maxLength": 100 },
        "color": { "type": "string", "maxLength": 20 },
        "description": { "type": "string", "maxLength": 300 }
      },
      "required": ["id", "name"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "Subject chapter within a specific class",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "subjectId": { "type": "string", "maxLength": 50 },
        "classId": { "type": "number" },
        "title": { "type": "string", "maxLength": 150 },
        "order": { "type": "number" }
      },
      "required": ["id", "subjectId", "classId", "title"]
    },
    "Question": {
      "title": "Question",
      "description": "Four-option MCQ item in the question bank",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "classId": { "type": "number" },
        "subjectId": { "type": "string", "maxLength": 50 },
        "chapterId": { "type": "string", "maxLength": 50 },
        "text": { "type": "string", "maxLength": 2000 },
        "correctOptionIndex": { "type": "number" },
        "explanation": { "type": "string", "maxLength": 2000 },
        "marks": { "type": "number" },
        "difficulty": { "type": "string", "enum": ["easy", "medium", "hard"] },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "classId", "subjectId", "text", "correctOptionIndex", "marks"]
    },
    "Quiz": {
      "title": "Quiz",
      "description": "Configured MCQ quiz with time limit, code, and marking rules",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "code": { "type": "string", "maxLength": 20 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 1000 },
        "classId": { "type": "number" },
        "subjectId": { "type": "string", "maxLength": 50 },
        "durationMinutes": { "type": "number" },
        "totalMarks": { "type": "number" },
        "passingPercentage": { "type": "number" },
        "negativeMarking": { "type": "boolean" },
        "negativeMarkValue": { "type": "number" },
        "randomizeQuestions": { "type": "boolean" },
        "showAnswersAfterTest": { "type": "boolean" },
        "leaderboardEnabled": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "createdBy": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "code", "title", "classId", "subjectId", "durationMinutes", "totalMarks", "status"]
    },
    "QuizAttempt": {
      "title": "QuizAttempt",
      "description": "Student quiz submission record with calculated scores",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 50 },
        "quizId": { "type": "string", "maxLength": 50 },
        "quizCode": { "type": "string", "maxLength": 20 },
        "quizTitle": { "type": "string", "maxLength": 200 },
        "studentId": { "type": "string", "maxLength": 50 },
        "studentName": { "type": "string", "maxLength": 100 },
        "classId": { "type": "number" },
        "startedAt": { "type": "string" },
        "submittedAt": { "type": "string" },
        "timeTakenSeconds": { "type": "number" },
        "score": { "type": "number" },
        "totalMarks": { "type": "number" },
        "percentage": { "type": "number" },
        "correctCount": { "type": "number" },
        "incorrectCount": { "type": "number" },
        "unansweredCount": { "type": "number" },
        "negativeMarksDeducted": { "type": "number" },
        "passed": { "type": "boolean" }
      },
      "required": ["id", "quizId", "quizCode", "studentId", "studentName", "classId", "score", "totalMarks", "percentage"]
    }
  },
  "firestore": {
    "/teachers/{teacherId}": {
      "schema": "Teacher",
      "description": "Teacher profiles and permissions"
    },
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Student roster and class enrollments"
    },
    "/subjects/{subjectId}": {
      "schema": "Subject",
      "description": "Curriculum subjects"
    },
    "/chapters/{chapterId}": {
      "schema": "Chapter",
      "description": "Subject chapters for Classes 1 to 10"
    },
    "/questionBank/{questionId}": {
      "schema": "Question",
      "description": "Ready-made and teacher-authored question bank"
    },
    "/quizzes/{quizId}": {
      "schema": "Quiz",
      "description": "Published and draft tests"
    },
    "/quizAttempts/{attemptId}": {
      "schema": "QuizAttempt",
      "description": "Student test scores, answers, and timestamps"
    }
  }
}
